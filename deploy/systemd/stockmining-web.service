[Unit]
Description=stockmining read-only web dashboard
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=stockmining
Group=stockmining
EnvironmentFile=/etc/stockmining/env
EnvironmentFile=-/etc/stockmining/web.env
WorkingDirectory=/var/lib/stockmining
ExecStart=/bin/sh -c 'exec /opt/stockmining/.venv/bin/stockmining web --host "${WEB_HOST:-127.0.0.1}" --port "${WEB_PORT:-8787}"'
Restart=always
RestartSec=10
MemoryMax=300M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
