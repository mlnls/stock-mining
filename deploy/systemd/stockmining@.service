[Unit]
Description=stockmining %i job
After=network-online.target
Wants=network-online.target
OnFailure=stockmining-alert@%n.service

[Service]
Type=oneshot
User=stockmining
Group=stockmining
EnvironmentFile=/etc/stockmining/env
Environment=PATH=/var/lib/stockmining/.local/bin:/usr/local/bin:/usr/bin:/bin:/snap/bin
WorkingDirectory=/var/lib/stockmining
ExecStart=/opt/stockmining/.venv/bin/stockmining %i
ExecStartPost=+/usr/local/bin/stockmining-backup
TimeoutStartSec=3h
Nice=5
