[Unit]
Description=Telegram alert for failed %i

[Service]
Type=oneshot
EnvironmentFile=/etc/stockmining/env
ExecStart=/bin/bash -c 'curl -s -X POST "https://api.telegram.org/bot$${TELEGRAM_BOT_TOKEN}/sendMessage" -d chat_id="$${TELEGRAM_CHAT_ID}" --data-urlencode text="❌ %i 실패 — journalctl -u %i 확인"'
